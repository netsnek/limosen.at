{
  "name": "limosen.at",
  "description": "limosen.at, built on jaen",
  "version": "1.0.0",
  "private": true,
  "author": "Florian Kleber",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "cross-env NODE_OPTIONS=--max-old-space-size=8192 gatsby develop -H 0.0.0.0",
    "start": "yarn develop",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 gatsby build",
    "deploy": "cross-env NODE_OPTIONS=--max-old-space-size=8192 gatsby build && wrangler pages deploy ./public",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package && yarn typegen",
    "typegen": "chakra typegen src/styles/theme/system.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.11.1",
    "@reach/router": "^1.3.4",
    "autoprefixer": "^10.4.0",
    "flexsearch": "^0.7.43",
    "gatsby": "^5.11.0",
    "gatsby-jaen-app": "link:../jaen/packages/gatsby-jaen-app",
    "gatsby-jaen-emailwerk": "link:../jaen/packages/gatsby-jaen-emailwerk",
    "gatsby-plugin-cloudflare-pages": "^1.0.3",
    "gatsby-plugin-i18n-l10n": "^5.14.1",
    "gatsby-plugin-jaen": "link:../jaen/packages/gatsby-plugin-jaen",
    "gatsby-plugin-offline": "^6.13.1",
    "gatsby-plugin-postcss": "^6.13.1",
    "gatsby-source-jaen": "link:../jaen/packages/gatsby-source-jaen",
    "github-slugger": "^2.0.0",
    "gqty": "^3.2.2",
    "hast-util-sanitize": "^5.0.1",
    "jaen": "link:../jaen/packages/jaen",
    "jaen-fields-mdx": "link:../jaen/packages/jaen-fields-mdx",
    "mapbox-gl": "^3.19.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.0",
    "prismjs": "^1.29.0",
    "quantum-circuit": "^0.9.218",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-fast-marquee": "^1.6.4",
    "react-highlight-words": "^0.20.0",
    "react-intl": "6.8.9",
    "react-simple-code-editor": "^0.13.1",
    "react-slick": "^0.31.0",
    "react-tsparticles": "^2.12.2",
    "slick-carousel": "^1.8.1",
    "snek-query": "^0.0.114",
    "tailwindcss": "^3.4.0",
    "tsparticles": "^2.12.0",
    "use-debounce": "^10.0.0",
    "zxcvbn": "^4.4.2"
