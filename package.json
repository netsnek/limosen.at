    "msgpackr": "^1.10.2",
    "ordered-binary": "^1.5.3",
    "graphql": "link:../jaen/node_modules/graphql",
    "jaen": "link:../jaen/packages/jaen",
    "gatsby-plugin-jaen": "link:../jaen/packages/gatsby-plugin-jaen",
    "gatsby-source-jaen": "link:../jaen/packages/gatsby-source-jaen",
    "gatsby-jaen-emailwerk": "link:../jaen/packages/gatsby-jaen-emailwerk",
    "jaen-fields-mdx": "link:../jaen/packages/jaen-fields-mdx",
    "gatsby-jaen-app": "link:../jaen/packages/gatsby-jaen-app"
